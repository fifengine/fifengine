    name="questbubble"
    position="312,200"
    size="440,300"
    base_color="188,0,0"
    border_size="2"
    border_color="255,220,180"
    corner_radius="16"
    tail_width="26"
    tail_height="20"
    tail_direction="BottomLeft"
    tail_profile="rounded"
    bubble_style="round"
    tail_offset="0.25"
