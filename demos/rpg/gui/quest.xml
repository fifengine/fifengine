      </HBox>
      <HBox opaque="0">
        <Label
          name="questtext"
          min_size="400,180"
          max_size="400,180"
          size="400,180"
          wrap_text="1"
          base_color="0,0,0,0"
        />
      </HBox>
      <HBox opaque="0">
        <Button name="accept" text="Accept"/>
        <Button name="decline" text="Decline"/>
      </HBox>
    </VBox>
  </SpeechBubble>
</Container>
